{
  "format": "semadmit-isoprax-legacy-number-adapter/0.1",
  "status": "normative v0.1 M0 legacy adapter mapping vectors; not Semadmit request JSON",
  "input_representation": "IEEE-754 binary64 bits in big-endian hexadecimal; non-finite values have no JCS JSON number spelling",
  "mapping": "Serialize the binary64 value as an RFC 8785 JCS number, expand any exponent to plain decimal without rounding, then apply the v0.1 canonical decimal profile and target field bounds",
  "cases": [
    {
      "id": "score-zero",
      "ieee754_hex": "0000000000000000",
      "target_field": "score",
      "expected_jcs_number": "0",
      "expected_expanded_decimal": "0",
      "expected_profile": "accepted"
    },
    {
      "id": "score-negative-zero",
      "ieee754_hex": "8000000000000000",
      "target_field": "score",
      "expected_jcs_number": "0",
      "expected_expanded_decimal": "0",
      "expected_profile": "accepted",
      "note": "A legacy binary64 negative zero maps to zero; a raw Semadmit JSON number token -0 is rejected."
    },
    {
      "id": "score-half",
      "ieee754_hex": "3fe0000000000000",
      "target_field": "score",
      "expected_jcs_number": "0.5",
      "expected_expanded_decimal": "0.5",
      "expected_profile": "accepted"
    },
    {
      "id": "score-small-exponent",
      "ieee754_hex": "3e7ad7f29abcaf48",
      "target_field": "score",
      "expected_jcs_number": "1e-7",
      "expected_expanded_decimal": "0.0000001",
      "expected_profile": "accepted"
    },
    {
      "id": "score-precision-at-limit",
      "ieee754_hex": "3d719799812dea11",
      "target_field": "score",
      "expected_jcs_number": "1e-12",
      "expected_expanded_decimal": "0.000000000001",
      "expected_profile": "accepted"
    },
    {
      "id": "score-precision-over-limit",
      "ieee754_hex": "3d3c25c268497682",
      "target_field": "score",
      "expected_jcs_number": "1e-13",
      "expected_expanded_decimal": "0.0000000000001",
      "expected_profile": "rejected",
      "rejection": "fractional_precision"
    },
    {
      "id": "score-out-of-range",
      "ieee754_hex": "3ff199999999999a",
      "target_field": "score",
      "expected_jcs_number": "1.1",
      "expected_expanded_decimal": "1.1",
      "expected_profile": "rejected",
      "rejection": "field_range"
    },
    {
      "id": "threshold-negative-quarter",
      "ieee754_hex": "bfd0000000000000",
      "target_field": "threshold.value.decimal",
      "expected_jcs_number": "-0.25",
      "expected_expanded_decimal": "-0.25",
      "expected_profile": "accepted"
    },
    {
      "id": "threshold-max-absolute",
      "ieee754_hex": "433fffffffffffff",
      "target_field": "threshold.value.decimal",
      "expected_jcs_number": "9007199254740991",
      "expected_expanded_decimal": "9007199254740991",
      "expected_profile": "accepted"
    },
    {
      "id": "threshold-over-absolute",
      "ieee754_hex": "4340000000000000",
      "target_field": "threshold.value.decimal",
      "expected_jcs_number": "9007199254740992",
      "expected_expanded_decimal": "9007199254740992",
      "expected_profile": "rejected",
      "rejection": "absolute_bound"
    },
    {
      "id": "nan-invalid",
      "ieee754_hex": "7ff8000000000000",
      "target_field": "score",
      "expected_jcs_number": null,
      "expected_expanded_decimal": null,
      "expected_profile": "rejected",
      "rejection": "nonfinite"
    },
    {
      "id": "infinity-invalid",
      "ieee754_hex": "7ff0000000000000",
      "target_field": "score",
      "expected_jcs_number": null,
      "expected_expanded_decimal": null,
      "expected_profile": "rejected",
      "rejection": "nonfinite"
    }
  ]
}
