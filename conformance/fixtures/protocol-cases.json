{
  "format": "semadmit-protocol-cases/0.1",
  "status": "normative v0.1 M0 fixtures; implementation conformance unproven",
  "input_recipes": {
    "request-mutation": "Resolve the named case request and apply operations in listed order. add inserts a new member at the RFC 6901 parent; replace replaces the value. replace-array-with-repeated-item resolves a source item and repeats it count times.",
    "request-ref-padded-line": "Serialize the referenced request as RFC 8785 JCS UTF-8, append the indicated byte until target_line_bytes is reached; the byte limit excludes LF.",
    "nested-objects": "Create an object with nest_levels nested members named key, ending in leaf. Root request has depth 1; the extra object is depth 2."
  },
  "cases": [
